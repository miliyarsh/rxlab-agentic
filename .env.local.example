# .env.local.example
#
# Copy this file to `.env.local` and fill in your values.
# `.env.local` is git-ignored. Never commit real values.

# --- AWS ---
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=755272426836

# --- Deployed API (from: terraform -chdir=infra/envs/dev output -raw api_url) ---
API_URL=https://u44gtv84u4.execute-api.us-east-1.amazonaws.com
REPORTS_BUCKET=rxlab-reports-dev-755272426836

# --- Terraform state backend (created once via scripts/bootstrap.sh) ---
TF_STATE_BUCKET=rxlab-tfstate-755272426836-us-east-1
TF_LOCK_TABLE=rxlab-terraform-locks

# --- GitHub Actions OIDC deploy role ---
GITHUB_REPO=YOUR_GITHUB_USER/rxlab-agentic
AWS_ROLE_ARN=arn:aws:iam::755272426836:role/rxlab-github-actions-deploy

# --- Bedrock (US inference profile — required for on-demand invoke) ---
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0

# --- Alerting ---
ALERT_EMAIL=you@example.com
