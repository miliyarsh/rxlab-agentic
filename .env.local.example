# .env.local.example
#
# Copy this file to `.env.local` and fill in your values.
# `.env.local` is git-ignored. Never commit real values.

# --- AWS ---
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=000000000000

# --- Terraform state backend (created once via scripts/bootstrap.sh) ---
TF_STATE_BUCKET=rxlab-tfstate-000000000000-us-east-1
TF_LOCK_TABLE=rxlab-terraform-locks

# --- GitHub Actions OIDC deploy role ---
GITHUB_REPO=YOUR_GITHUB_USER/rxlab-agentic
AWS_ROLE_ARN=arn:aws:iam::000000000000:role/rxlab-github-actions-deploy

# --- Bedrock ---
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# --- Alerting ---
ALERT_EMAIL=you@example.com
